{
  "name": "real-estate-contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && python3 scripts/serve.py",
    "build": "tsc -b && python3 production/build.py && vite build && python3 scripts/integrate-sharing.py && python3 scripts/integrate-purchase.py && python3 scripts/integrate-closing.py",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs production/tests/*.test.mjs",
    "lint": "eslint src/sharing vite.config.ts",
    "preview": "python3 scripts/serve.py"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
